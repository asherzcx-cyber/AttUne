# Never put real keys in index.html or app.js.
GEMINI_API_KEY=paste_your_gemini_key_here
# Flash-Lite is used for fast, short coaching replies.
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=paste_your_elevenlabs_key_here
# Pick a voice from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
PORT=3000
# Local-only OpenBCI GUI UDP receiver port. Keep this on the demo machine.
OPENBCI_UDP_PORT=12345
# Tiger Data / PostgreSQL connection string. Keep it private like API keys.
DATABASE_URL=postgres://username:password@host:5432/database?sslmode=require
# Use a long random value in a real deployment.
SESSION_SECRET=replace_this_with_a_long_random_secret
# Optional Snowflake analytics workspace. Export only de-identified summaries.
SNOWFLAKE_ACCOUNT_URL=https://your-account.snowflakecomputing.com
SNOWFLAKE_TOKEN=your_snowflake_programmatic_access_token
